diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..6c50976
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,23 @@
+services:
+  api:
+    build: .
+    expose:
+      - "8000"          # visível só na rede interna, NÃO publicado no host
+    volumes:
+      - dados:/app/data
+    environment:
+      - DB_PATH=/app/data/banco_a3.db
+    restart: unless-stopped
+
+  nginx:
+    image: nginx:1.27-alpine
+    ports:
+      - "8080:80"       # único ponto de entrada externo
+    volumes:
+      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
+    depends_on:
+      - api
+    restart: unless-stopped
+
+volumes:
+  dados:
diff --git a/nginx/nginx.conf b/nginx/nginx.conf
new file mode 100644
index 0000000..d9aa11b
--- /dev/null
+++ b/nginx/nginx.conf
@@ -0,0 +1,47 @@
+# Nginx como proxy reverso na frente da API FastAPI/Uvicorn
+
+# Rate limiting: 10 req/s por IP, com zona de 10 MB para guardar os IPs
+limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
+limit_req_status 429;
+
+upstream api_backend {
+    # "api" é o nome do serviço no docker-compose (porta interna do Uvicorn)
+    server api:8000;
+    # Para balancear carga, basta adicionar mais instâncias:
+    # server api2:8000;
+}
+
+server {
+    listen 80;
+    server_name _;
+
+    server_tokens off;            # esconde a versão do Nginx
+    client_max_body_size 1m;      # limita o tamanho do corpo da requisição
+
+    # Cabeçalhos de segurança
+    add_header X-Content-Type-Options nosniff always;
+    add_header X-Frame-Options DENY always;
+    add_header Referrer-Policy no-referrer always;
+
+    location / {
+        limit_req zone=api_limit burst=20 nodelay;
+
+        proxy_pass http://api_backend;
+        proxy_http_version 1.1;
+
+        # Repassa ao Uvicorn os dados reais do cliente
+        proxy_set_header Host              $host;
+        proxy_set_header X-Real-IP         $remote_addr;
+        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+
+        proxy_connect_timeout 5s;
+        proxy_read_timeout    30s;
+    }
+
+    # Healthcheck do próprio Nginx
+    location = /nginx-health {
+        access_log off;
+        return 200 "ok\n";
+    }
+}
